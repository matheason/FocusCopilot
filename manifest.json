{
  "manifest_version": 3,
  "name": "FocusCopilot",
  "version": "1.0",
  "description": "An intelligent browser extension that tracks time and boosts focus.",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icon.png"
  }
}